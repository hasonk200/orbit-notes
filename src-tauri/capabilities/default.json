{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Orbit desktop capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}
