# Copy to .env.local and fill in your Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# OAuth web client ID (Google Cloud console > APIs & Services > Credentials)
VITE_GOOGLE_CLIENT_ID=
# Root HTTPS URL of the deployed Orbit API service
VITE_ORBIT_AI_URL=
