{
  "name": "Orbit",
  "short_name": "Orbit",
  "description": "Notes, to-dos and projects in one place.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#1e1b3a",
  "theme_color": "#f7f6f3",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "To-do", "url": "./todos", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today", "url": "./calendar?mode=day", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
